# Copy this file to android/key.properties (gitignored) and fill in real values
# ONLY when you are ready to sign a Play Store build with a new upload key.
#
# Do NOT add key.properties while you still need to update the APK already
# installed on your phone. That install is signed with the Android debug key.
# A new keystore cannot update that install in place, and uninstalling wipes data.
#
# Generate a keystore (one time, keep a backup):
#   keytool -genkey -v -keystore android/app/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=upload
storeFile=upload-keystore.jks
